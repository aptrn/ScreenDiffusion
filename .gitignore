.venv/
venv/
local_cache/
__pycache__/
*.pyc

# Downloaded models & TensorRT engines
models/
engines/
# ultralytics resolves WEIGHTS_DIR to <cwd>/weights and drops a 338 MB CLIP
# checkpoint there. bench/detector_runner.py repoints it at the shared models root;
# this catches anything that does not go through the harness.
weights/
*.safetensors
*.engine

# Node tooling (Sandcastle agent loop only; the app is Python)
node_modules/

# Sandcastle runtime state: .env, logs, monitor history.
# main.mts is versioned - it is the loop's configuration.
.sandcastle/*
!.sandcastle/main.mts
